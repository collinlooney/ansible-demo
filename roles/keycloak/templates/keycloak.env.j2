# {{ ansible_managed }} — secrets: root-owned 0600 (systemd parses as PID 1,
# the unit's user never needs read access to this file).
KC_DB=mysql
KC_DB_URL=jdbc:mysql://{{ keycloak_db_host }}:{{ keycloak_db_port }}/{{ keycloak_db_name }}?useSSL=false&allowPublicKeyRetrieval=true
KC_DB_USERNAME={{ keycloak_db_username }}
KC_DB_PASSWORD={{ keycloak_db_password }}
KC_BOOTSTRAP_ADMIN_USERNAME={{ keycloak_bootstrap_admin_username }}
KC_BOOTSTRAP_ADMIN_PASSWORD={{ keycloak_bootstrap_admin_password }}
KC_HTTP_ENABLED=true
KC_HOSTNAME_STRICT={{ 'true' if keycloak_hostname_strict | bool else 'false' }}
KC_HEALTH_ENABLED=true
JAVA_OPTS_APPEND={{ keycloak_java_opts }}
