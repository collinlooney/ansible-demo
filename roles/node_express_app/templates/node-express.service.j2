[Unit]
Description={{ app_name | systemd_env_escape }} (Node + Express)
After=network.target

[Service]
Type=simple
User={{ app_user | systemd_env_escape }}
Group={{ app_group | systemd_env_escape }}
WorkingDirectory={{ app_root | systemd_env_escape }}
EnvironmentFile={{ app_root | systemd_env_escape }}/.env
ExecStart={{ [node_bin, app_root ~ "/server.js"] | systemd_exec_escape }}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
